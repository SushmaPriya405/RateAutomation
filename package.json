{
  "name": "automation_2306",
  "version": "1.0.0",
  "description": "Test Automation Interface with Web UI",
  "main": "launcher.js",
  "bin": "launcher.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:dwb": "npx playwright test ./tests/PDF_SeperatorDWB.spec.ts",
    "test:dws": "npx playwright test ./tests/GPA_Dwelling_Special.spec.ts",
    "test:ho": "npx playwright test ./tests/GPA_HomeOwners.spec.ts",
    "test:multi-user": "node test-multi-user.js",
    "test:sessions": "curl http://localhost:3003/api/debug/sessions",
    "install-deps": "npm install express multer",
    "azure:install": "npm ci --omit=dev && npx playwright install --with-deps chromium",
    "azure:start": "npm run azure:install && npm start",
    "build": "echo 'No build step required for Node.js app'",
    "postinstall": "npx playwright install --with-deps chromium",
    "build:exe": "pkg . --output dist/AMOD-Automation.exe"
  },
  "pkg": {
    "assets": [
      "web-interface/**/*",
      "testdata/**/*",
      "config/**/*",
      "node_modules/xlsx/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "automation",
    "playwright",
    "testing",
    "web-interface"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "18.x",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.0.3",
    "@types/pdfmake": "^0.2.11",
    "nodemon": "^3.1.10",
    "pkg": "^5.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@estruyf/github-actions-reporter": "^1.10.0",
    "archiver": "^7.0.1",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "form-data": "^4.0.4",
    "image-size": "^2.0.2",
    "jimp": "^0.16.1",
    "multer": "^1.4.4",
    "pdfmake": "^0.2.20",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "xlsx": "^0.18.5"
  }
}
